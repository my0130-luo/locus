    <string name="onboarding_intro_title">Your agent, on your phone</string>
    <string name="onboarding_intro_body">Locus is an AI agent that works for you: it reads, writes, browses and runs code to get things done.</string>
    <string name="onboarding_runs_here">Runs here</string>
    <string name="onboarding_runs_here_body">The agent, its tools, your files and its memory all live on this phone.</string>
    <string name="onboarding_your_keys">Your keys</string>
    <string name="onboarding_your_keys_body">Bring a key from the AI provider you choose, or run a model on the phone itself. No Locus account.</string>
    <string name="onboarding_you_decide">You decide</string>
    <string name="onboarding_you_decide_body">Every action goes through your approval rules, and everything it does is logged.</string>
    <string name="onboarding_intro_footer">Setup takes a few minutes. Everything after the model step is optional and can be changed later in Settings.</string>
    <string name="onboarding_privacy_title">What leaves your phone</string>
    <string name="onboarding_privacy_body">Locus has no servers. Here is exactly where your data goes.</string>
