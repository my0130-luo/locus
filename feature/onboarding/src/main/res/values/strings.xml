    <string name="onboarding_provider_privacy_body">Your messages and the files the agent reads go directly to the AI provider you pick, under that provider\'s terms. With the on-device model, nothing leaves at all.</string>
    <string name="onboarding_keys_privacy_body">API keys and passwords are kept in an encrypted vault on this phone, never shown to the model.</string>
    <string name="onboarding_network_privacy_body">Websites, services and machines are contacted only when you, or the agent with your approval, use them.</string>
    <string name="onboarding_update_check_title">Check GitHub for new versions?</string>
    <string name="onboarding_update_check_body">About once a day on Wi-Fi, one request to GitHub with nothing about you. You decide whether to install; this bypasses app-store checks. Change it in Settings → About &amp; privacy.</string>
    <string name="onboarding_allow_body">Runs without asking.</string>
    <string name="onboarding_ask_body">Waits for you to approve each time, in the app or from a notification.</string>
    <string name="onboarding_deny_body">Never runs.</string>
    <string name="onboarding_permissions_hint">You can change any single tool later in Settings → Permissions.</string>
    <string name="onboarding_consent">I understand that what I ask Locus to work on is sent to the AI provider I choose, and that the agent acts within the approvals above.</string>
