    <string name="agent_helper_timeout">Helper time limit</string>
    <string name="agent_helper_timeout_body">How long one helper may work, including time waiting for your approval. When it runs out, or you stop a helper, it</string>
    <string name="agent_helper_timeout_body2">hands back what it had: its last reply, its tool results and the files it changed, marked as a partial result.</string>
    <string name="agent_helper_timeout_body3">The agent can continue it from there. Applies to helpers started from now on.</string>
