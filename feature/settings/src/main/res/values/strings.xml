    <string name="agent_task_budget">Task budget</string>
    <string name="agent_task_budget_prices">Cost needs model prices: turn on model details (models.dev) in Settings → Models.</string>
    <string name="agent_task_budget_body">The default limit for each task and the helpers it starts. At a limit Locus pauses between steps and asks whether to go on.</string>
    <string name="agent_task_budget_note">Cached input counts at a tenth, and time waiting for you doesn\'t count. A chat can set its own in the composer\'s options.</string>
    <string name="agent_helpers">Helpers</string>
    <string name="agent_helpers_continue">Continue when a helper reports back</string>
    <string name="agent_helpers_continue_body">When a background helper finishes after the reply, Locus picks the chat up again with its report</string>
    <string name="agent_helper_timeout">Helper time limit</string>
    <string name="agent_helper_timeout_body">How long one helper may work, including time waiting for your approval. When it runs out, or you stop a helper, it</string>
    <string name="agent_helper_timeout_body2">hands back what it had: its last reply, its tool results and the files it changed, marked as a partial result.</string>
    <string name="agent_helper_timeout_body3">The agent can continue it from there. Applies to helpers started from now on.</string>
